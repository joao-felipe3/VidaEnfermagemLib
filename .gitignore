# Credentials & env
.env
.env.*
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Whitelist ThirdParty vendor precompiled libraries needed by plugins
!Plugins/**/Thirdparty/**/*.lib
!Plugins/**/ThirdParty/**/*.lib
!Plugins/**/Thirdparty/**/*.a
!Plugins/**/ThirdParty/**/*.a
!Plugins/**/Thirdparty/**/*.so
!Plugins/**/ThirdParty/**/*.so
!Plugins/**/Thirdparty/**/*.dll
!Plugins/**/ThirdParty/**/*.dll
!Plugins/**/Thirdparty/**/*.dylib
!Plugins/**/ThirdParty/**/*.dylib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vs/
.idea/
.vscode/

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/
Plugins/**/Binaries/

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/

# Compiled source files for the engine to use
Intermediate/
Plugins/**/Intermediate/

# Cache files for the editor to use
DerivedDataCache/

# Gerador de voz (ambiente, modelos e audios gerados)
Tools/VoiceGen/.venv/
Tools/VoiceGen/models/
Tools/VoiceGen/output/
Tools/LipSync/rhubarb/
Tools/LipSync/previews/
Tools/VoiceGen/amostras/
__pycache__/
*.pyc
